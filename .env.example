# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# live = real Claude calls, mock = canned responses with zero spend
LLM_MODE=mock
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
LLM_MAX_TOKENS=16000

REDIS_PASSWORD=change-me-redis
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_USER=enclave
POSTGRES_DB=enclave

# Hard stop for a single run, in US dollars of Claude usage
MAX_RUN_USD=5
# How many parallel scout containers
SCOUT_REPLICAS=2
# How many search briefs the coordinator hands out per run
SCOUT_BRIEFS=4
# How many finalists get a full plan
FINALISTS=5
# Planner/critic revision rounds before the plan is frozen
MAX_REVISION_ROUNDS=2
# Seconds to wait for a stage before giving up on missing agents
STAGE_TIMEOUT_S=1800

DASHBOARD_PORT=8080
LOG_LEVEL=INFO
TZ=America/Denver
